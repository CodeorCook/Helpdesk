# Copy into backend root .env; never commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB_HELPDESK
DB_USER=postgres
DB_PASSWORD=
# Confirm real schema before setting public/helpdesk.
DB_SCHEMA=helpdesk
JWT_SECRET_KEY=
SESSION_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
DEFAULT_PRIORITY_ORDER=2
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_EXTENSIONS=.txt,.pdf,.png,.jpg,.jpeg
# Relative to backend root, outside public/static/frontend. Ignored by Git.
UPLOAD_DIR=storage/attachments
# Optional private manager audit directory; relative to Backend root. No secrets/PII in audit events.
# MANAGER_AUDIT_DIR=storage/audit

# Gemini Developer API: required only for AI, no default model. Never use VITE_ prefixes.
GEMINI_KEY=
GEMINI_MODEL=